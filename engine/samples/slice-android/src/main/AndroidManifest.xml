<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Layer 3 fetches the guest over the network. -->
  <uses-permission android:name="android.permission.INTERNET" />

  <!-- Cleartext is scoped to the development server in res/xml/network_security_config.xml. -->
  <application
      android:label="Dogwood Slice"
      android:allowBackup="false"
      android:networkSecurityConfig="@xml/network_security_config">
    <activity
        android:name=".SliceActivity"
        android:exported="true"
        android:theme="@style/Theme.Dogwood">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
