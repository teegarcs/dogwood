<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted for the Android emulator's view of the development machine, and for
  nothing else. Real Over-The-Air delivery rides Hypertext Transfer Protocol Secure (HTTPS).

  The Ed25519 manifest signature is what makes a payload trustworthy, but it is not a substitute
  for transport security: a signature proves who built the code, not who is watching it travel.
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">localhost</domain>
  </domain-config>
</network-security-config>
