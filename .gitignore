# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editors / IDEs
.idea/
.vscode/
*.iml
*.swp
*~

# Local agent tooling (machine-specific; keep shared config in AGENTS.md)
.claude/settings.local.json
.claude/*.local.json

# Build output (for when the reference implementation lands)
build/
out/
dist/
*.wasm
*.klib
local.properties
.gradle/

# Third-party Compose API dumps, fetched on demand by tools/measure-compose-surface.py
# at the commit pinned in tools/api-dumps/SOURCE.txt. Not vendored (~2.9 MB).
tools/api-dumps/*.txt
!tools/api-dumps/SOURCE.txt
__pycache__/

# Generated into the source tree by the Zipline Gradle plugin's writeZiplineWebpackConfig task
tools/phase0/*/webpack.config.d/generated-zipline-webpack-config.js

# Kotlin build-tool state, not source.
.kotlin/
